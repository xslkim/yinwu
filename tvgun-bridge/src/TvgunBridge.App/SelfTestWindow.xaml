<Window x:Class="TvgunBridge.App.SelfTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自检模式"
        WindowStyle="None"
        WindowState="Maximized"
        Background="Black"
        Topmost="True"
        KeyDown="OnKeyDown">
    <Grid>
        <Canvas x:Name="PlayCanvas"/>
        <TextBlock x:Name="TxtScore"
                   Foreground="White" FontSize="28" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"/>
        <TextBlock Foreground="#FF888888" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
                   Text="用手机瞄准白色靶子开枪 · ESC 退出自检"/>
    </Grid>
</Window>
