<Window x:Class="TvgunBridge.App.OverlayBorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TvgunBridge Overlay"
        Width="320" Height="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        IsHitTestVisible="False"
        Visibility="Hidden">
    <Canvas x:Name="BorderCanvas" IsHitTestVisible="False"/>
</Window>
