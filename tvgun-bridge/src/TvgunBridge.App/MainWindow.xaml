<Window x:Class="TvgunBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="tvgun-bridge 控制台"
        Width="540" Height="640"
        Background="#FF14181D"
        Foreground="#FFE8E8E8"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE8E8E8"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2A313B"/>
            <Setter Property="Foreground" Value="#FFE8E8E8"/>
            <Setter Property="BorderBrush" Value="#FF3D4654"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE8E8E8"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FF9FB4D0"/>
            <Setter Property="BorderBrush" Value="#FF2A313B"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="tvgun 手机光枪 → TeknoParrot 桥接器" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>

            <GroupBox Header="状态">
                <StackPanel>
                    <TextBlock x:Name="TxtService"/>
                    <TextBlock x:Name="TxtAim"/>
                    <TextBlock x:Name="TxtWindow"/>
                    <TextBlock x:Name="TxtInjection"/>
                    <TextBlock x:Name="TxtLastAction" Foreground="#FF9FB4D0"/>
                    <TextBlock x:Name="TxtError" Foreground="#FFFF7070" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="游戏适配">
                <StackPanel>
                    <ComboBox x:Name="ComboGames" DisplayMemberPath="DisplayName" Margin="0,2"/>
                    <TextBlock x:Name="TxtIni" Foreground="#FF9FD3A8" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="控制">
                <StackPanel>
                    <Button x:Name="BtnStartStop" Content="开始桥接" Click="OnStartStopClick"/>
                    <CheckBox x:Name="ChkInject"
                              Content="启用输入注入（移动鼠标 / 点击 / 按键，默认关闭防误触）"
                              Checked="OnInjectChecked" Unchecked="OnInjectUnchecked"/>
                    <Button x:Name="BtnCalibrate" Content="两点校准向导" Click="OnCalibrateClick"/>
                    <Button x:Name="BtnSelfTest" Content="自检模式（打鸭子）" Click="OnSelfTestClick"/>
                    <Button x:Name="BtnBorderless" Content="游戏窗口无边框化" Click="OnBorderlessClick"/>
                    <Button x:Name="BtnExit" Content="退出" Click="OnExitClick"/>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="TxtHotkeys" FontSize="11" Opacity="0.65" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
