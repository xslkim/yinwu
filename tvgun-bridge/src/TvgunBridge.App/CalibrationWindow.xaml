<Window x:Class="TvgunBridge.App.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="两点校准"
        WindowStyle="None"
        WindowState="Maximized"
        AllowsTransparency="True"
        Background="#B3000000"
        Topmost="True"
        Cursor="Cross"
        KeyDown="OnKeyDown">
    <Grid>
        <Canvas x:Name="TargetCanvas"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0">
            <TextBlock x:Name="TxtInstruction"
                       Foreground="White" FontSize="20" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="TxtResult"
                       Foreground="#FF9FD3A8" FontSize="14"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <Button x:Name="BtnRetry"
                    Content="重新开始 (R)"
                    Width="160" Margin="0,12,0,0" Padding="8,4"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Click="OnRetryClick"/>
        </StackPanel>
    </Grid>
</Window>
